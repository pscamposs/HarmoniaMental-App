# Example env file for HarmoniaMental-App (Psymphony)
# Preencha os valores apropriados antes de rodar o app.
# NÃO coloque segredos reais neste arquivo — mantenha valores sensíveis fora do repositório.

# Spotify (client credentials)
# ATENÇÃO: client secret é sensível e NÃO deveria estar embutido no app cliente.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=

# Google Gemini (IA)
EXPO_PUBLIC_GEMINI_API_KEY=

# Build options (opcional)
EXPO_USE_COMMUNITY_AUTOLINKING=0
