{
  "expo": {
    "name": "Psymphony",
    "slug": "Psymphony",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-safe.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-whitemode-safe.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF7",
      "dark": {
        "image": "./assets/splash-darkmode-safe.png",
        "resizeMode": "contain",
        "backgroundColor": "#12101E"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground-safe.png",
        "backgroundColor": "#FAFAF7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.psymphony"
    },
    "web": {
      "favicon": "./assets/app-icon-safe.png"
    }
  }
}
